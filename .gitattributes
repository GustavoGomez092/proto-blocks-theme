# Paths excluded from `git archive` — i.e. from the distributable theme zip
# the release workflow builds AND from the WP Engine deploy tree (both deploy
# workflows extract `git archive HEAD`). Dev/CI scaffolding never ships to
# wp-admin or to a server.
/.github              export-ignore
/docs                 export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
/.superpowers         export-ignore
/README.md            export-ignore
/package.json         export-ignore
/package-lock.json    export-ignore
/playwright.config.js export-ignore
/tests                export-ignore
/test-results         export-ignore
/proto-blocks/taxi-fixture-a export-ignore
/proto-blocks/taxi-fixture-b export-ignore
